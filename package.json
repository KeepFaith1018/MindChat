{
  "name": "MindChat",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "db:generate": "dotenv -e .env -- prisma generate",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:seed": "dotenv -e .env -- tsx server/db/seed.ts",
    "db:studio": "dotenv -e .env -- prisma studio",
    "db:push": "dotenv -e .env -- prisma db push",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "preview": "nuxt preview",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "nuxt prepare",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@langchain/community": "^1.1.23",
    "@langchain/core": "^1.1.32",
    "@langchain/openai": "^1.2.13",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/ui": "^4.5.1",
    "@phosphor-icons/vue": "^2.2.1",
    "@pinia/nuxt": "^0.11.3",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@tanstack/vue-virtual": "^3.13.22",
    "@vueuse/core": "^14.2.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "eventsource-parser": "^3.0.6",
    "jose": "^6.2.1",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.1",
    "nuxt": "^4.3.1",
    "pdf-parse": "^2.4.5",
    "pinia": "^3.0.4",
    "shiki": "^4.0.2",
    "uuid": "^13.0.0",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@iconify-json/lucide": "^1.2.96",
    "@nuxt/fonts": "^0.14.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^3.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.4.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/parser": "^8.57.0",
    "dotenv-cli": "^11.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "only-allow": "^1.2.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.4.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.57.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.5",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml,md}": "prettier --write"
  }
}
